[Version]
Signature   = "$WINDOWS NT$"
Class       = AudioProcessingObject
ClassGuid   = {5989fce8-9cd0-467d-8a6a-5419e31529d4}
Provider    = %ProviderName%
DriverVer   = 10/08/2026,0.5.0.0
CatalogFile = uzjam-apo.cat
PnpLockDown = 1

[Manufacturer]
%MfgName% = ApoComponents,NTamd64.10.0...22621

[ApoComponents.NTamd64.10.0...22621]
%Apo.ComponentDesc% = ApoComponent_Install,APO\VEN_UZJM&CID_APO

[ApoComponent_Install]
CopyFiles = Apo_CopyFiles
AddReg = Apo_AddReg

[Apo_CopyFiles]
uzjam_endpoint_apo.dll

[Apo_AddReg]
HKR,Classes\CLSID\%UZJAM_ENDPOINT_CLSID%,,,%Apo.FriendlyName%
HKR,Classes\CLSID\%UZJAM_ENDPOINT_CLSID%\InProcServer32,,0x00020000,%13%\uzjam_endpoint_apo.dll
HKR,Classes\CLSID\%UZJAM_ENDPOINT_CLSID%\InProcServer32,ThreadingModel,,"Both"

HKR,AudioEngine\AudioProcessingObjects\%UZJAM_ENDPOINT_CLSID%,FriendlyName,,%Apo.FriendlyName%
HKR,AudioEngine\AudioProcessingObjects\%UZJAM_ENDPOINT_CLSID%,Copyright,,%Copyright%
HKR,AudioEngine\AudioProcessingObjects\%UZJAM_ENDPOINT_CLSID%,MajorVersion,0x00010001,1
HKR,AudioEngine\AudioProcessingObjects\%UZJAM_ENDPOINT_CLSID%,MinorVersion,0x00010001,0
HKR,AudioEngine\AudioProcessingObjects\%UZJAM_ENDPOINT_CLSID%,Flags,0x00010001,0x0000000e
HKR,AudioEngine\AudioProcessingObjects\%UZJAM_ENDPOINT_CLSID%,MinInputConnections,0x00010001,1
HKR,AudioEngine\AudioProcessingObjects\%UZJAM_ENDPOINT_CLSID%,MaxInputConnections,0x00010001,1
HKR,AudioEngine\AudioProcessingObjects\%UZJAM_ENDPOINT_CLSID%,MinOutputConnections,0x00010001,1
HKR,AudioEngine\AudioProcessingObjects\%UZJAM_ENDPOINT_CLSID%,MaxOutputConnections,0x00010001,1
HKR,AudioEngine\AudioProcessingObjects\%UZJAM_ENDPOINT_CLSID%,MaxInstances,0x00010001,0xffffffff
HKR,AudioEngine\AudioProcessingObjects\%UZJAM_ENDPOINT_CLSID%,NumAPOInterfaces,0x00010001,1
HKR,AudioEngine\AudioProcessingObjects\%UZJAM_ENDPOINT_CLSID%,APOInterface0,,"{FD7F2B29-24D0-4B5C-B177-592C39F9CA10}"

[ApoComponent_Install.HW]
AddReg = FriendlyName_AddReg

[FriendlyName_AddReg]
HKR,,FriendlyName,,%Apo.ComponentDesc%

[ApoComponent_Install.Services]
AddService=,2

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
uzjam_endpoint_apo.dll = 1

[DestinationDirs]
Apo_CopyFiles = 13

[SignatureAttributes]
uzjam_endpoint_apo.dll = SignatureAttributes.PETrust

[SignatureAttributes.PETrust]
PETrust = true

[Strings]
MfgName = "UZjam"
ProviderName = "UZjam"
Apo.ComponentDesc = "UZjam Endpoint Audio Component"
Apo.FriendlyName = "UZjam Endpoint EQ"
Copyright = "Copyright (c) UZjam"
