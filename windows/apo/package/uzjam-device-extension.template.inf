; DEVICE-VENDOR INTEGRATION TEMPLATE — not directly installable.
; Replace the two __PLACEHOLDER__ values, give each shipped package a unique
; ExtensionId, validate with InfVerif, generate a catalog, then Microsoft-sign.
[Version]
Signature   = "$WINDOWS NT$"
Class       = Extension
ClassGuid   = {e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider    = %ProviderName%
ExtensionId = {70e0d90d-c34e-4dad-97c9-7e37bb1896cb}
DriverVer   = 10/08/2026,0.5.0.0
CatalogFile = uzjam-device-extension.cat
PnpLockDown = 1

[Manufacturer]
%MfgName% = DeviceExtensions,NTamd64.10.0...22621

[DeviceExtensions.NTamd64.10.0...22621]
%Device.ExtensionDesc% = DeviceExtension_Install,%TargetHardwareId%

[DeviceExtension_Install]

[DeviceExtension_Install.HW]
AddReg = FriendlyName_AddReg

[FriendlyName_AddReg]
HKR,,FriendlyName,,%Device.ExtensionDesc%

[DeviceExtension_Install.Components]
AddComponent = UzjamApo,,Apo_AddComponent

[Apo_AddComponent]
ComponentIDs = VEN_UZJM&CID_APO
Description = "UZjam Endpoint EQ"

[DeviceExtension_Install.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,%TargetTopologyReference%,DeviceExtensions.I.APO
AddInterface = %KSCATEGORY_TOPOLOGY%,%TargetTopologyReference%,DeviceExtensions.I.APO

[DeviceExtensions.I.APO]
AddReg = APO.I.Association0.AddReg

[APO.I.Association0.AddReg]
HKR,FX\0,%PKEY_FX_Association%,,%KSNODETYPE_ANY%
HKR,FX\0,%PKEY_CompositeFX_ModeEffectClsid%,%REG_MULTI_SZ%,%UZJAM_ENDPOINT_CLSID%
HKR,FX\0,%PKEY_MFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_MEDIA%,%AUDIO_SIGNALPROCESSINGMODE_MOVIE%
HKR,FX\0\%UZJAM_PROPERTY_CONTEXT%,%PKEY_FX_Association%,,%KSNODETYPE_ANY%
HKR,FX\0\%UZJAM_PROPERTY_CONTEXT%\User,,,

[Strings]
MfgName = "UZjam"
ProviderName = "UZjam"
Device.ExtensionDesc = "UZjam Endpoint EQ device extension"
TargetHardwareId = "__TARGET_AUDIO_HARDWARE_ID__"
TargetTopologyReference = "__RENDER_TOPOLOGY_REFERENCE__"
UZJAM_ENDPOINT_CLSID = "{7EC11543-6693-43CE-B7DA-50512A736FF8}"
UZJAM_PROPERTY_CONTEXT = "{96ED8048-DDB4-49D9-919C-C37C2A7DD0FB}"
KSCATEGORY_AUDIO = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY = "{00000000-0000-0000-0000-000000000000}"
PKEY_FX_Association = "{D04E05A6-594B-4FB6-A80D-01AF5EED7D1D},0"
PKEY_CompositeFX_ModeEffectClsid = "{D04E05A6-594B-4FB6-A80D-01AF5EED7D1D},14"
PKEY_MFX_ProcessingModes_Supported_For_Streaming = "{D3993A3F-99C2-4402-B5EC-A92A0367664B},6"
REG_MULTI_SZ = 0x00010000
AUDIO_SIGNALPROCESSINGMODE_DEFAULT = "{C18E2F7E-933D-4965-B7D1-1EEF228D2AF3}"
AUDIO_SIGNALPROCESSINGMODE_MEDIA = "{4780004E-7133-41D8-8C74-660DADD2C0EE}"
AUDIO_SIGNALPROCESSINGMODE_MOVIE = "{B26FEB0D-EC94-477C-9494-D1AB8E753F6E}"
